local M = {}
local os_ = require("tios.os")

M.C = {
    STTY = os_.find_cmd_safer("stty"),
    TPUT = os_.find_cmd_safer("tput")
}

M.echo = tio.echo
M.inkey = tio.inkey
M.write = io.write

function M.echoln(str)
    return M.echo(str .. "\r\n")
end

local function conv_lf_to_crlf(str)
    local new_str = str:gsub("\r*\n", "\r\n")
    return new_str
end

function M.print(...)
    local args = {...}
    local argN = #args
    for i = 1, argN - 1 do
        io.write(conv_lf_to_crlf(tostring(args[i])))
        io.write("\t")
    end
    if argN > 0 then
        io.write(conv_lf_to_crlf(tostring(args[argN])))
    end
    io.write("\r\n")
end

function M.read()
    return tio.input("")
end

--
-- stty setting
--
M.tty_setting_saved = {}

function M.stty(...)
    local args = {...}
    if args[1] == "SAVE" then
        local fh = io.popen(M.C.STTY .. " -g")
        local cur_tty_setting = fh:read("*a"):gsub("\r?\n?$", "")
        fh:close()
        table.insert(M.tty_setting_saved, cur_tty_setting)
    elseif args[1] == "RESTORE" then
        local fh = io.popen(M.C.STTY .. " " .. table.remove(M.tty_setting_saved))
        local out = fh:read("*a"):gsub("\r?\n?$", "")
        fh:close()
    else
        local fh = io.popen(M.C.STTY .. " " .. table.concat(args, " "))
        local out = fh:read("*a")
        fh:close()
    end
    return true
end

function M.stty_os()
    tio.set_stdout_mode("os")
    tio.set_stdin_mode("os")
    return true
end

function M.stty_tio()
    tio.set_stdin_mode("tio")
    tio.set_stdout_mode("tio")
    return true
end

M.tty_inout_scheme_stack = {}
M.inout_scheme = "tio"

function M.inout_scheme_apply_to_tio()
    if M.inout_scheme == "os" then
        tio.pause_input_thread()
        tio.set_sleep_echo(false)
    else
        tio.resume_input_thread()
        tio.set_sleep_echo(true)
    end
end

function M.push_inout_scheme(scm)
    -- push current setting
    local fh = io.popen(M.C.STTY .. " -g")
    local cur_tty_setting = fh:read("*a"):gsub("\r?\n?$", "")
    if not M.inout_scheme then
        M.inout_scheme = "tio"
    end
    scm_ent = {M.inout_scheme, cur_tty_setting}
    table.insert(M.tty_inout_scheme_stack, scm_ent)

    -- change setting
    if scm == "os" then
        M.stty_os()
        M.inout_scheme = "os"
    else
        M.stty_tio()
        M.inout_scheme = "tio"
    end
    M.inout_scheme_apply_to_tio()
end

function M.pop_inout_scheme()
    local inout_scheme, tty_setting = table.unpack(table.remove(M.tty_inout_scheme_stack))
    if tty_setting then
        local fh = io.popen(M.C.STTY .. " " .. tty_setting)
        local out = fh:read("*a"):gsub("\r?\n?$", "")
        fh:close()
    end
    M.inout_scheme = inout_scheme or "tio"
    M.inout_scheme_apply_to_tio()
end

function M.get_screen_size()
    local f = io.popen(M.C.STTY .. " size")
    if not f then
        return nil
    end
    local result = f:read("*all")
    f:close()
    local scr_lines, scr_columns = result:match("(%d+)%s+(%d+)")
    return scr_columns, scr_lines
end

M.C.RESET_SCREEN_STR = string.format("%cc", 0x1b)
M.C.CLEAR_SCREEN_STR = string.format("%c[H%c[2J", 0x1b, 0x1b)
M.C.CURSOR_OFF_STR = string.format("%c[?25l", 0x1b)
M.C.CURSOR_ON_STR = string.format("%c[?25h", 0x1b)
M.C.MOVE_CURSOR_FMT = string.format("%c[%%d;%%dH", 0x1b)

function M.reset_screen()
    -- this clears cursor settings and screensaver's saved screen too.
    io.write(M.C.RESET_SCREEN_STR)
    io.flush()
end

function M.clear_screen()
    io.write(M.C.CLEAR_SCREEN_STR)
    io.flush()
end

function M.cursor_off()
    io.write(M.C.CURSOR_OFF_STR)
    io.flush()
end

function M.cursor_on()
    io.write(M.C.CURSOR_ON_STR)
    io.flush()
end

function M.move_cursor(x, y)
    io.write(string.format(M.C.MOVE_CURSOR_FMT, y + 1, x + 1)); -- begin with 1
    io.flush()
end

function M.switch_to_alternative_screen()
    os.execute(M.C.TPUT .. " smcup")
end

function M.switch_back_to_default_screen()
    os.execute(M.C.TPUT .. " rmcup")
end

return M
